@startuml stage_internal_loop
title Часть 1: цикл retry и прогрессивный порог сходства

skinparam dpi 200
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 15
skinparam ActivityBackgroundColor #F5F5F5
skinparam ActivityBorderColor #555555
skinparam ActivityFontSize 15
skinparam ActivityDiamondFontSize 14
skinparam ArrowColor #444444
skinparam ArrowFontSize 13
skinparam NoteBackgroundColor #FFF8E1
skinparam NoteBorderColor #C0A050
skinparam NoteFontSize 13

' === партиции в красивой рамке ===
skinparam PartitionBorderColor #1F3A5F
skinparam PartitionBorderThickness 2
skinparam PartitionBackgroundColor #DCE6F2
skinparam PartitionFontStyle bold
skinparam PartitionFontSize 18
skinparam PartitionFontColor #1F3A5F

skinparam LegendBackgroundColor #E3F2FD
skinparam LegendBorderColor #1F3A5F
skinparam LegendFontSize 13

start
:Список классов,\nтребующих аугментации\nдо TARGET_COUNT;

partition "Для каждого класса" {
    :n_needed = TARGET_COUNT − len(existing)\nattempt = 1, n_collected = 0\nsim_threshold = 0.95;

    while (attempt ≤ MAX_RETRIES\nИ n_collected < n_needed?) is (да)

        if (attempt > 2?) then (да)
            :sim_threshold =\nmin(0.95 + 0.01·(attempt−2), 0.98);
        else (нет)
            :sim_threshold = 0.95;
        endif

        :**Генерация:**\nсборка промпта + vLLM.generate()\nбатчем OVERSAMPLE_FACTOR=5 × still_needed;

        :**Валидация (7 фильтров)**\n→ детали в части 2;

        :**LLM-судья**\n→ детали в части 2;

        :take = min(len(valid), still_needed)\nn_collected += take\nattempt += 1;

    endwhile (готово)

    if (n_collected < n_needed?) then (да)
        :Предупреждение в лог;
    else (нет)
    endif
}

:Запись чекпоинта\n**data_after_stage{N}.csv**;
note right
  Чекпоинт переживает рестарт:
  следующий запуск продолжит
  с того же места
end note

stop

legend right
  **Прогрессивный порог сходства**

  • Этапы 1 и 2 (per-attempt):
      первые 2 попытки — 0.95,
      далее +0.01 за попытку, потолок 0.98

  • Этап 3 (per-round):
      +0.10 за круг (на 2-м круге уже 1.05
      → косинусный фильтр фактически отключён,
      чтобы добрать упёртые классы)
end legend

@enduml
