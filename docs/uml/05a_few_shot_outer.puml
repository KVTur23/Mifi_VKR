@startuml few_shot_outer
title Часть 1: внешний поток few-shot prompt-классификации\n(load → experiments → save → unload)

skinparam dpi 200
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 15
skinparam ActivityBackgroundColor #F5F5F5
skinparam ActivityBorderColor #555555
skinparam ActivityFontSize 15
skinparam ActivityDiamondFontSize 14
skinparam ArrowColor #444444
skinparam ArrowFontSize 13
skinparam NoteBackgroundColor #FFF8E1
skinparam NoteBorderColor #C0A050
skinparam NoteFontSize 13

skinparam PartitionBorderColor #1F3A5F
skinparam PartitionBorderThickness 2
skinparam PartitionBackgroundColor #DCE6F2
skinparam PartitionFontStyle bold
skinparam PartitionFontSize 18
skinparam PartitionFontColor #1F3A5F

start
:**CLI:**\npython scripts/run_few_shot.py\n  --models qwen_14b --experiments 0 1 3;

:Чтение **results/prompt_results.csv**\n(возобновление после падения):\ndone = {(model, exp_key)};
:Фильтрация уже посчитанных пар\n→ список (model, exp_key) к запуску;

partition "Для каждой модели M из матрицы" {
    :**load_model(model_cfg)**\n→ llm, tokenizer;
    note right
      AWQ → vLLM (tensor_parallel=2),
      иначе transformers с device_map="auto".
      Промпт оборачивается в chat_template.
    end note

    partition "Для каждого exp_key" {
        :**load_few_shot_examples(K, mode)**\n→ examples_by_class\n(оригиналы + аугментация при нехватке);
        :**Обработка df_test**\n(build_prompt → generate → extract\n— подробно в части 2)\n→ predictions, raw, skipped;
        :**evaluate_prompt_classification**\n→ balanced_acc, macro_f1,\nf1_group_{A, B, C}, unknown_rate;
        :Запись **preds_<M>_exp<key>.csv**\n(text, true_label, predicted_label,\nraw_response, skipped);
        :Инкрементальная запись\n**prompt_results.csv**\n(строка сохраняется сразу после метрик);
    }

    :**unload_model:**\ndel model + gc.collect()\n+ torch.cuda.empty_cache()\n+ sleep(5);
    note right
      Обязательно перед следующей моделью —
      иначе на A100-40GB следующая 14B/32B
      не влезет.
    end note
}

:Обновление **all_methods_comparison.csv**\n(traditional + prompt + finetune\nв одну сводную таблицу);
stop

@enduml
