@startuml stage_internal_filters
title Часть 2: 7 фильтров валидации и LLM-судья

skinparam dpi 200
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 15
skinparam ActivityBackgroundColor #F5F5F5
skinparam ActivityBorderColor #555555
skinparam ActivityFontSize 15
skinparam ActivityDiamondFontSize 14
skinparam ArrowColor #444444
skinparam ArrowFontSize 13
skinparam NoteBackgroundColor #FFF8E1
skinparam NoteBorderColor #C0A050
skinparam NoteFontSize 13

' === партиции в красивой рамке ===
skinparam PartitionBorderColor #1F3A5F
skinparam PartitionBorderThickness 2
skinparam PartitionBackgroundColor #DCE6F2
skinparam PartitionFontStyle bold
skinparam PartitionFontSize 18
skinparam PartitionFontColor #1F3A5F

skinparam LegendBackgroundColor #E3F2FD
skinparam LegendBorderColor #1F3A5F
skinparam LegendFontSize 13

start
:Кандидаты от генератора\n(oversample × n_needed текстов);

partition "Валидация — validate_generated_texts()" {
    :**1. Точные дубликаты**\nсравнение по strip().lower();
    :**2. Минимальная длина**\n≥ validation.min_text_length\n(по умолчанию 500 символов);
    :**3. Язык**\nlangdetect должен вернуть "ru";
    :**4. Вырожденность**\nunique_ratio < 0.2 ИЛИ\nфраза 3+ слов повторяется 3+ раз;
    :**5. CJK-символы**\nкитайский / японский / корейский\n(артефакт Qwen-моделей);
    :**6. Промпт-утечка**\nмета-фразы, фрагменты системного промпта,\nMarkdown-разметка, NER-токены;
    :**7. Косинусное сходство**\nSBERT, двусторонний порог:\nверхний sim_threshold (0.95→0.98),\nнижний 0.5 (искажение после NLLB);
}

partition "LLM-as-a-judge" {
    if (stage 1 или stage 2?) then (да)
        :Промпт судьи\n(judge_score.txt для stage 1,\njudge_paraphrase.txt для stage 2);
        :Оценка по шкале 1-10;
        :Отсев < MIN_JUDGE_SCORE = 5.0;
        :Сортировка по убыванию оценки\nи берём первые n_needed;
    else (stage 3 с use_judge = false)
        :random.shuffle(валидных кандидатов);
        :Берём первые n_needed\nбез оценки качества;
    endif
}

:**Список принятых текстов**\nдля добавления в датасет;
stop

legend right
  **Почему судья отключён на этапе 3**

  NLLB-выходы стабильно получают
  оценки 1.0-2.2 при пороге 2.5
  → режется ~92% и так чистого пула.

  Каждый прогон судьи добавляет +30с
  × N промежуточных языков × N кругов.
end legend

@enduml
