@startuml few_shot_inner
title Итерация few-shot по одному письму\n

skinparam dpi 200
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 15
skinparam ActivityBackgroundColor #F5F5F5
skinparam ActivityBorderColor #555555
skinparam ActivityFontSize 15
skinparam ActivityDiamondFontSize 14
skinparam ArrowColor #444444
skinparam ArrowFontSize 13
skinparam NoteBackgroundColor #FFF8E1
skinparam NoteBorderColor #C0A050
skinparam NoteFontSize 13

skinparam PartitionBorderColor #1F3A5F
skinparam PartitionBorderThickness 2
skinparam PartitionBackgroundColor #DCE6F2
skinparam PartitionFontStyle bold
skinparam PartitionFontSize 18
skinparam PartitionFontColor #1F3A5F

skinparam LegendBackgroundColor #E3F2FD
skinparam LegendBorderColor #1F3A5F
skinparam LegendFontSize 13

start
:Письмо **text** из df_test;

partition "Сборка промпта" {
    :**build_prompt(text, K, mode, no_desc, max_example_chars)**;
    note right
      Шаблон:
      • роль (маршрутизация
        нефтегазовой корреспонденции)
      • {class_list} — 36 классов
      • {class_descriptions} (если mode ≠ no_desc)
      • правила (1 вариант, не выдумывать)
      • {examples_block} — K примеров,
        обрезка до max_example_chars
      • Письмо: {text} / Подразделение:
    end note
    :**apply_chat_template(tokenizer, prompt)**\n→ chat_prompt;
}

if (длина chat_prompt ≥ max_context − 100?) then (да)
    :**skipped = True**\ nромпт не убирается\nв контекст модели;
    stop
else (нет)
    :**generate_response(llm, chat_prompt,\ngeneration_params)**\n→ raw_response;

    partition "extract_prediction — каскад из 7 стратегий" {
        :**1.** Срез и удаление префиксов\n("Подразделение:", "Ответ:",\n"Категория:", маркеры списка);
        :**2.** Нормализация (lowercase + только\nа-яёa-z0-9 + сжатие пробелов)\n→ точное совпадение с названием класса;
        :**3.** Название класса ⊂ кандидат\n→ берём самое длинное\n(устойчиво к «Блок по ...»);
        :**4.** Кандидат (> 5 символов) ⊂ название класса;
        :**5.** difflib.get_close_matches\n(нечёткое, опечатки, fuzzy_cutoff = 0.6);
        :**6.** Поиск любого названия класса\nв полном (ненормализованном) ответе;
        :**7.** predicted_label = "unknown";
        note right
          Стратегии пробуются по порядку,
          первое совпадение — победитель.
          "unknown" учитывается отдельно
          (метрика unknown_rate).
        end note
    }

    :**predicted_label;**
endif

:Append (text, true_label, predicted_label,\nraw_response, skipped) в df_preds;
stop


@enduml
